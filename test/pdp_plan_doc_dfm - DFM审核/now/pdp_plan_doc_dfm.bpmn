<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="diagram_pdp_plan_doc_dfm" targetNamespace="http://flowable.org/bpmn">
  <bpmn2:process id="pdp_plan_doc_dfm" name="DFM审核" isExecutable="true">
    <bpmn2:startEvent id="Event_start">
      <bpmn2:extensionElements>
        <flowable:properties>
          <flowable:property name="cancelEnable" value="false" />
        </flowable:properties>
      </bpmn2:extensionElements>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Activity_execute" name="执行上传">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>60</flowable:candidateStrategy>
        <flowable:candidateParam>${executorUserId}</flowable:candidateParam>
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_start_execute" sourceRef="Event_start" targetRef="Activity_execute" />
    <bpmn2:userTask id="Activity_superior" name="上级审核">
      <bpmn2:extensionElements>
        <flowable:formData />
        <flowable:candidateStrategy>60</flowable:candidateStrategy>
        <flowable:candidateParam>${executorLeaderUser}</flowable:candidateParam>
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_execute_superior" sourceRef="Activity_execute" targetRef="Activity_superior" />
    <bpmn2:userTask id="Activity_charge" name="计划负责人">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>60</flowable:candidateStrategy>
        <flowable:candidateParam>${PdpPlanChargeUser}</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_00juxe4</bpmn2:incoming>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_superior_charge" sourceRef="Activity_superior" targetRef="Activity_0i2gadj" />
    <bpmn2:endEvent id="Event_end" />
    <bpmn2:sequenceFlow id="Flow_charge_end" sourceRef="Activity_charge" targetRef="Event_end" />
    <bpmn2:userTask id="Activity_0i2gadj" name="DFM检查">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>70</flowable:candidateStrategy>
        <flowable:candidateParam>2</flowable:candidateParam>
        <flowable:properties>
          <flowable:property name="ocean" value="1" />
          <flowable:property name="batchReview" value="1" />
        </flowable:properties>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_superior_charge</bpmn2:incoming>
      <bpmn2:outgoing>Flow_00juxe4</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_00juxe4" sourceRef="Activity_0i2gadj" targetRef="Activity_charge" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pdp_plan_doc_dfm">
    <bpmndi:BPMNPlane id="pdp_plan_doc_dfm_di" bpmnElement="pdp_plan_doc_dfm">
      <bpmndi:BPMNShape id="BPMNShape_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="162" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_execute" bpmnElement="Activity_execute">
        <dc:Bounds x="250" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_superior" bpmnElement="Activity_superior">
        <dc:Bounds x="410" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_charge" bpmnElement="Activity_charge">
        <dc:Bounds x="780" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_end" bpmnElement="Event_end">
        <dc:Bounds x="922" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_0i2gadj_di" bpmnElement="Activity_0i2gadj">
        <dc:Bounds x="580" y="200" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_start_execute" bpmnElement="Flow_start_execute">
        <di:waypoint x="198" y="240" />
        <di:waypoint x="250" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_execute_superior" bpmnElement="Flow_execute_superior">
        <di:waypoint x="350" y="240" />
        <di:waypoint x="410" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_superior_charge" bpmnElement="Flow_superior_charge">
        <di:waypoint x="510" y="240" />
        <di:waypoint x="580" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_charge_end" bpmnElement="Flow_charge_end">
        <di:waypoint x="880" y="240" />
        <di:waypoint x="922" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_00juxe4_di" bpmnElement="Flow_00juxe4">
        <di:waypoint x="680" y="240" />
        <di:waypoint x="780" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

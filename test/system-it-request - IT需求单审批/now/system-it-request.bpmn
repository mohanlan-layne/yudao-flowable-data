<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="diagram_system-it-request" targetNamespace="http://flowable.org/bpmn">
  <bpmn2:process id="system-it-request" name="IT需求单审批" isExecutable="true">
    <bpmn2:startEvent id="Event_start" name="开始">
      <bpmn2:outgoing>Flow_start_submit</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Activity_submit" name="需求填报">
      <bpmn2:extensionElements>
        <flowable:formData />
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId></flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds></flowable:assignEmptyUserIds>
        <flowable:approveType>2</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_start_submit</bpmn2:incoming>
      <bpmn2:outgoing>Flow_submit_review</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_review" name="需求评审">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
        <flowable:formData />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_submit_review</bpmn2:incoming>
      <bpmn2:outgoing>Flow_review_to_gateway</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_review" name="评审结果">
      <bpmn2:incoming>Flow_review_to_gateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_to_reject</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_bug_to_schedule</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_to_design</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_no_prototype_to_approve</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Activity_reject" name="回绝确认">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_reject</bpmn2:incoming>
      <bpmn2:outgoing>Flow_reject_end</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:endEvent id="Event_end_reject" name="结束">
      <bpmn2:incoming>Flow_reject_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:userTask id="Activity_design" name="方案设计">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_to_design</bpmn2:incoming>
      <bpmn2:outgoing>Flow_design_to_merge</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_merge_approve" name="">
      <bpmn2:incoming>Flow_design_to_merge</bpmn2:incoming>
      <bpmn2:incoming>Flow_no_prototype_to_approve</bpmn2:incoming>
      <bpmn2:outgoing>Flow_merge_to_approve</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Activity_plan_approve" name="方案审批">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_merge_to_approve</bpmn2:incoming>
      <bpmn2:outgoing>Flow_approve_to_confirm</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_plan_confirm" name="方案确认">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_approve_to_confirm</bpmn2:incoming>
      <bpmn2:outgoing>Flow_confirm_to_merge</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_merge_schedule" name="">
      <bpmn2:incoming>Flow_confirm_to_merge</bpmn2:incoming>
      <bpmn2:incoming>Flow_bug_to_schedule</bpmn2:incoming>
      <bpmn2:outgoing>Flow_merge_to_schedule</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Activity_schedule" name="排期中">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_merge_to_schedule</bpmn2:incoming>
      <bpmn2:outgoing>Flow_schedule_develop</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_develop" name="开发中">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>35</flowable:candidateStrategy>
        <flowable:candidateParam />
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_schedule_develop</bpmn2:incoming>
      <bpmn2:outgoing>Flow_develop_to_gateway</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_after_develop" name="开发完成">
      <bpmn2:incoming>Flow_develop_to_gateway</bpmn2:incoming>
      <bpmn2:outgoing>Flow_bug_to_deploy</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_develop_internal</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Activity_internal_test" name="内测">
      <bpmn2:extensionElements>
        <flowable:approveMethod>4</flowable:approveMethod>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_develop_internal</bpmn2:incoming>
      <bpmn2:outgoing>Flow_internal_trial</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_trial_test" name="试用测试">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_internal_trial</bpmn2:incoming>
      <bpmn2:outgoing>Flow_trial_deploy</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_deploy" name="上线部署">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1240</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_trial_deploy</bpmn2:incoming>
      <bpmn2:incoming>Flow_bug_to_deploy</bpmn2:incoming>
      <bpmn2:outgoing>Flow_deploy_end</bpmn2:outgoing>
      <bpmn2:multiInstanceLoopCharacteristics isSequential="true" flowable:collection="${coll_userList}">
        <bpmn2:loopCardinality xsi:type="bpmn2:tFormalExpression">1</bpmn2:loopCardinality>
        <bpmn2:completionCondition xsi:type="bpmn2:tFormalExpression">${ nrOfCompletedInstances &gt;= nrOfInstances }</bpmn2:completionCondition>
      </bpmn2:multiInstanceLoopCharacteristics>
    </bpmn2:userTask>
    <bpmn2:endEvent id="Event_end" name="结束">
      <bpmn2:incoming>Flow_deploy_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_start_submit" sourceRef="Event_start" targetRef="Activity_submit" />
    <bpmn2:sequenceFlow id="Flow_submit_review" sourceRef="Activity_submit" targetRef="Activity_review" />
    <bpmn2:sequenceFlow id="Flow_review_to_gateway" sourceRef="Activity_review" targetRef="Gateway_review" />
    <bpmn2:sequenceFlow id="Flow_to_reject" name="另行处理" sourceRef="Gateway_review" targetRef="Activity_reject">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${receiveStatus == '3'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_reject_end" sourceRef="Activity_reject" targetRef="Event_end_reject" />
    <bpmn2:sequenceFlow id="Flow_bug_to_schedule" name="BUG" sourceRef="Gateway_review" targetRef="Gateway_merge_schedule">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${receiveStatus == '2' and requestType == '3'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_to_design" name="需要原型设计" sourceRef="Gateway_review" targetRef="Activity_design">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${receiveStatus == '2' and requestType != '3' and needDesign == '1'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_no_prototype_to_approve" name="不需要原型" sourceRef="Gateway_review" targetRef="Gateway_merge_approve">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${receiveStatus == '2' and requestType != '3' and needDesign == '2'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_design_to_merge" sourceRef="Activity_design" targetRef="Gateway_merge_approve" />
    <bpmn2:sequenceFlow id="Flow_merge_to_approve" sourceRef="Gateway_merge_approve" targetRef="Activity_plan_approve" />
    <bpmn2:sequenceFlow id="Flow_approve_to_confirm" sourceRef="Activity_plan_approve" targetRef="Activity_plan_confirm" />
    <bpmn2:sequenceFlow id="Flow_confirm_to_merge" sourceRef="Activity_plan_confirm" targetRef="Gateway_merge_schedule" />
    <bpmn2:sequenceFlow id="Flow_merge_to_schedule" sourceRef="Gateway_merge_schedule" targetRef="Activity_schedule" />
    <bpmn2:sequenceFlow id="Flow_schedule_develop" sourceRef="Activity_schedule" targetRef="Activity_develop" />
    <bpmn2:sequenceFlow id="Flow_develop_to_gateway" sourceRef="Activity_develop" targetRef="Gateway_after_develop" />
    <bpmn2:sequenceFlow id="Flow_bug_to_deploy" name="BUG" sourceRef="Gateway_after_develop" targetRef="Activity_deploy">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${requestType == '3'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_develop_internal" sourceRef="Gateway_after_develop" targetRef="Activity_internal_test">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${requestType != '3'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_internal_trial" sourceRef="Activity_internal_test" targetRef="Activity_trial_test" />
    <bpmn2:sequenceFlow id="Flow_trial_deploy" sourceRef="Activity_trial_test" targetRef="Activity_deploy" />
    <bpmn2:sequenceFlow id="Flow_deploy_end" sourceRef="Activity_deploy" targetRef="Event_end" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="system-it-request_di" bpmnElement="system-it-request">
      <bpmndi:BPMNShape id="Event_start_di" bpmnElement="Event_start">

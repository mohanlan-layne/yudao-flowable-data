        <di:waypoint x="555" y="220" />
        <di:waypoint x="715" y="220" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="596" y="202" width="56" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_design_to_merge_di" bpmnElement="Flow_design_to_merge">
        <di:waypoint x="660" y="100" />

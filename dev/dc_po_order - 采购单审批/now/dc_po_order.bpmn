<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="diagram_dc_po_order" targetNamespace="http://flowable.org/bpmn">
  <bpmn2:process id="dc_po_order" name="采购单审批" isExecutable="true">
    <bpmn2:startEvent id="Event_start">
      <bpmn2:outgoing>Flow_start_to_initiator</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Activity_initiator" name="发起人">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>36</flowable:candidateStrategy>
        <flowable:candidateParam />
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId />
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>2</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_start_to_initiator</bpmn2:incoming>
      <bpmn2:outgoing>Flow_initiator_to_po</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_initiator_to_xpo</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_po_approve" name="总监">
      <bpmn2:extensionElements>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId />
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:formData />
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1237</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_initiator_to_po</bpmn2:incoming>
      <bpmn2:outgoing>Flow_po_to_end</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_po_to_coo</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_xpo_approve" name="总监">
      <bpmn2:extensionElements>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId />
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:formData />
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1237</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_initiator_to_xpo</bpmn2:incoming>
      <bpmn2:outgoing>Flow_xpo_to_end</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_xpo_to_coo</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_coo" name="COO">
      <bpmn2:extensionElements>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId />
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:formData />
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1237</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_po_to_coo</bpmn2:incoming>
      <bpmn2:incoming>Flow_xpo_to_coo</bpmn2:incoming>
      <bpmn2:outgoing>Flow_coo_to_end</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:endEvent id="Event_end" name="结束">
      <bpmn2:incoming>Flow_po_to_end</bpmn2:incoming>
      <bpmn2:incoming>Flow_xpo_to_end</bpmn2:incoming>
      <bpmn2:incoming>Flow_coo_to_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_start_to_initiator" sourceRef="Event_start" targetRef="Activity_initiator" />
    <bpmn2:sequenceFlow id="Flow_initiator_to_po" sourceRef="Activity_initiator" targetRef="Activity_po_approve">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${orderType == 1}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_initiator_to_xpo" sourceRef="Activity_initiator" targetRef="Activity_xpo_approve">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${orderType == 2}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_po_to_end" sourceRef="Activity_po_approve" targetRef="Event_end">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${totalAmount &lt;= 50000}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_po_to_coo" sourceRef="Activity_po_approve" targetRef="Activity_coo">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${totalAmount &gt; 50000}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_xpo_to_end" sourceRef="Activity_xpo_approve" targetRef="Event_end">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${totalAmount &lt;= 50000}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_xpo_to_coo" sourceRef="Activity_xpo_approve" targetRef="Activity_coo">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${totalAmount &gt; 50000}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_coo_to_end" sourceRef="Activity_coo" targetRef="Event_end" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="dc_po_order_di" bpmnElement="dc_po_order">
      <bpmndi:BPMNShape id="Event_start_di" bpmnElement="Event_start">
        <dc:Bounds x="-218" y="252" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_initiator_di" bpmnElement="Activity_initiator">
        <dc:Bounds x="-130" y="230" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_po_approve_di" bpmnElement="Activity_po_approve">
        <dc:Bounds x="180" y="40" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_xpo_approve_di" bpmnElement="Activity_xpo_approve">
        <dc:Bounds x="180" y="420" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_coo_di" bpmnElement="Activity_coo">
        <dc:Bounds x="180" y="230" width="100" height="80" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_end_di" bpmnElement="Event_end">
        <dc:Bounds x="472" y="252" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="479" y="295" width="23" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_start_to_initiator_di" bpmnElement="Flow_start_to_initiator">
        <di:waypoint x="-182" y="270" />
        <di:waypoint x="-130" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_initiator_to_po_di" bpmnElement="Flow_initiator_to_po">
        <di:waypoint x="-30" y="270" />
        <di:waypoint x="80" y="270" />
        <di:waypoint x="80" y="80" />
        <di:waypoint x="180" y="80" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_initiator_to_xpo_di" bpmnElement="Flow_initiator_to_xpo">
        <di:waypoint x="-30" y="270" />
        <di:waypoint x="80" y="270" />
        <di:waypoint x="80" y="460" />
        <di:waypoint x="180" y="460" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_po_to_end_di" bpmnElement="Flow_po_to_end">
        <di:waypoint x="280" y="80" />
        <di:waypoint x="376" y="80" />
        <di:waypoint x="376" y="270" />
        <di:waypoint x="472" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_po_to_coo_di" bpmnElement="Flow_po_to_coo">
        <di:waypoint x="230" y="120" />
        <di:waypoint x="230" y="230" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_xpo_to_end_di" bpmnElement="Flow_xpo_to_end">
        <di:waypoint x="280" y="460" />
        <di:waypoint x="376" y="460" />
        <di:waypoint x="376" y="270" />
        <di:waypoint x="472" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_xpo_to_coo_di" bpmnElement="Flow_xpo_to_coo">
        <di:waypoint x="230" y="420" />
        <di:waypoint x="230" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_coo_to_end_di" bpmnElement="Flow_coo_to_end">
        <di:waypoint x="280" y="270" />
        <di:waypoint x="472" y="270" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

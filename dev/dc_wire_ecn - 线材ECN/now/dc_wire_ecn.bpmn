<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:flowable="http://flowable.org/bpmn"
                   targetNamespace="http://flowable.org/bpmn" id="diagram_dc_wire_ecn">
  <bpmn2:process id="dc_wire_ecn" name="线材ECN" isExecutable="true">
    <bpmn2:startEvent id="Event_start" name="开始"/>
    <bpmn2:userTask id="Activity_dcc_approve" name="DCC审批">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId/>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds/>
        <flowable:approveType>1</flowable:approveType>
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>true</flowable:reasonRequire>
        <flowable:buttonsSetting id="1" enable="true" displayName="通过" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="false" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="false" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="false" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="false" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="false" displayName="抄送" />
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Activity_dcc_approve"/>
    <bpmn2:endEvent id="Event_end" name="结束"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Activity_dcc_approve" targetRef="Event_end"/>
  </bpmn2:process>
</bpmn2:definitions>

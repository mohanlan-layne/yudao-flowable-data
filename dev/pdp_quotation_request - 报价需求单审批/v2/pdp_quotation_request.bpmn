        <flowable:assignEmptyUserIds></flowable:assignEmptyUserIds>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_start_approve" sourceRef="Event_start" targetRef="Activity_superior_approve"></sequenceFlow>

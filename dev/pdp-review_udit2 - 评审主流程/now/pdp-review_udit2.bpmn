      <bpmndi:BPMNShape id="BPMNShape_Activity_14vtu9y" bpmnElement="Activity_14vtu9y">
        <dc:Bounds x="140" y="180" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_16wb7d0" bpmnElement="Flow_16wb7d0">
        <di:waypoint x="68" y="220" />
        <di:waypoint x="140" y="220" />
      </bpmndi:BPMNEdge>

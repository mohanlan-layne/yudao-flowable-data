  <process id="pdp_plan_doc_dfm" name="DFM审核" isExecutable="true">
    <startEvent id="Event_start"></startEvent>
    <userTask id="Activity_execute" name="执行上传">
      <extensionElements>
        <flowable:candidateStrategy><![CDATA[60]]></flowable:candidateStrategy>
        <flowable:candidateParam><![CDATA[${executorUserId}]]></flowable:candidateParam>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_start_execute" sourceRef="Event_start" targetRef="Activity_execute"></sequenceFlow>
    <userTask id="Activity_superior" name="上级审核">
      <extensionElements>
        <flowable:formData></flowable:formData>
        <flowable:candidateStrategy><![CDATA[60]]></flowable:candidateStrategy>
        <flowable:candidateParam><![CDATA[${executorLeaderUser}]]></flowable:candidateParam>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_execute_superior" sourceRef="Activity_execute" targetRef="Activity_superior"></sequenceFlow>
    <userTask id="Activity_charge" name="计划负责人">
      <extensionElements>
        <flowable:candidateStrategy><![CDATA[60]]></flowable:candidateStrategy>
        <flowable:candidateParam><![CDATA[${PdpPlanChargeUser}]]></flowable:candidateParam>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_superior_charge" sourceRef="Activity_superior" targetRef="Activity_0i2gadj"></sequenceFlow>
    <endEvent id="Event_end"></endEvent>
    <sequenceFlow id="Flow_charge_end" sourceRef="Activity_charge" targetRef="Event_end"></sequenceFlow>
    <userTask id="Activity_0i2gadj" name="DFM检查">
      <extensionElements>
        <flowable:candidateStrategy><![CDATA[70]]></flowable:candidateStrategy>
        <flowable:candidateParam><![CDATA[2]]></flowable:candidateParam>
      </extensionElements>
    </userTask>
    <sequenceFlow id="Flow_00juxe4" sourceRef="Activity_0i2gadj" targetRef="Activity_charge"></sequenceFlow>
  </process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pdp_plan_doc_dfm">

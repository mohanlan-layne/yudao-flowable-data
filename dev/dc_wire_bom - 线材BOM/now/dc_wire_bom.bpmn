<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL"
                   xmlns:flowable="http://flowable.org/bpmn"
                   xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                   xmlns:omgdc="http://www.omg.org/spec/DD/20100524/DC"
                   xmlns:omgdi="http://www.omg.org/spec/DD/20100524/DI"
                   targetNamespace="http://flowable.org/bpmn" id="diagram_dc_wire_bom">
  <bpmn2:process id="dc_wire_bom" name="线材BOM" isExecutable="true">
    <bpmn2:startEvent id="Event_start" name="开始"/>
    <bpmn2:userTask id="Activity_eng_build" name="工程搭建BOM">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>60</flowable:candidateStrategy>
        <flowable:candidateParam>${engDri}</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId/>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds/>
        <flowable:approveType>1</flowable:approveType>
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="false" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="false" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="false" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="false" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="false" displayName="抄送" />
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_dcc_approve" name="DCC审批">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>1506</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>2</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_eng_build</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds/>
        <flowable:approveType>1</flowable:approveType>
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:buttonsSetting id="1" enable="true" displayName="通过" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="false" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="false" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="false" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="false" displayName="抄送" />
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_1" sourceRef="Event_start" targetRef="Activity_eng_build"/>
    <bpmn2:sequenceFlow id="Flow_2" sourceRef="Activity_eng_build" targetRef="Activity_dcc_approve"/>
    <bpmn2:endEvent id="Event_end" name="结束"/>
    <bpmn2:sequenceFlow id="Flow_3" sourceRef="Activity_dcc_approve" targetRef="Event_end"/>
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_dc_wire_bom">
    <bpmndi:BPMNPlane id="BPMNPlane_dc_wire_bom" bpmnElement="dc_wire_bom">
      <bpmndi:BPMNShape id="Event_start_di" bpmnElement="Event_start">
        <omgdc:Bounds x="120" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_eng_build_di" bpmnElement="Activity_eng_build">
        <omgdc:Bounds x="220" y="150" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Activity_dcc_approve_di" bpmnElement="Activity_dcc_approve">
        <omgdc:Bounds x="470" y="150" width="160" height="100" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Event_end_di" bpmnElement="Event_end">
        <omgdc:Bounds x="700" y="182" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <omgdi:waypoint x="156" y="200" />
        <omgdi:waypoint x="220" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <omgdi:waypoint x="380" y="200" />
        <omgdi:waypoint x="470" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <omgdi:waypoint x="630" y="200" />
        <omgdi:waypoint x="700" y="200" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>

<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:flowable="http://flowable.org/bpmn" id="diagram_dc_customer_entertain" targetNamespace="http://flowable.org/bpmn">
  <bpmn2:process id="dc_customer_entertain" name="客户招待申请" isExecutable="true">
    <bpmn2:startEvent id="Event_start">
      <bpmn2:outgoing>Flow_start_to_initiator</bpmn2:outgoing>
    </bpmn2:startEvent>
    <bpmn2:userTask id="Activity_initiator" name="发起人">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>36</flowable:candidateStrategy>
        <flowable:candidateParam />
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId />
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>2</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_start_to_initiator</bpmn2:incoming>
      <bpmn2:outgoing>Flow_initiator_to_leader</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_leader_approve" name="直属领导审批">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>39</flowable:candidateStrategy>
        <flowable:candidateParam />
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_initiator</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_initiator_to_leader</bpmn2:incoming>
      <bpmn2:outgoing>Flow_leader_to_gw</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:exclusiveGateway id="Gateway_region" name="地区判断" default="Flow_gw_to_js">
      <bpmn2:incoming>Flow_leader_to_gw</bpmn2:incoming>
      <bpmn2:outgoing>Flow_gw_to_dg</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_gw_to_sz</bpmn2:outgoing>
      <bpmn2:outgoing>Flow_gw_to_js</bpmn2:outgoing>
    </bpmn2:exclusiveGateway>
    <bpmn2:userTask id="Activity_zjb_approve" name="总经办审核">
      <bpmn2:extensionElements>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_initiator</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:candidateStrategy>10</flowable:candidateStrategy>
        <flowable:candidateParam>1</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_gw_to_dg</bpmn2:incoming>
      <bpmn2:outgoing>Flow_zjb_to_czj</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_czj_confirm" name="需求确认">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>320</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_initiator</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:copyStrategy>30</flowable:copyStrategy>
        <flowable:copyParam>357,331,319</flowable:copyParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_zjb_to_czj</bpmn2:incoming>
      <bpmn2:outgoing>Flow_czj_to_end</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_sz_confirm" name="需求确认">
      <bpmn2:extensionElements>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_initiator</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>946</flowable:candidateParam>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_gw_to_sz</bpmn2:incoming>
      <bpmn2:outgoing>Flow_sz_to_end</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:userTask id="Activity_wyy_confirm" name="需求确认">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>30</flowable:candidateStrategy>
        <flowable:candidateParam>945</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId>Activity_initiator</flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds />
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="true" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
      <bpmn2:incoming>Flow_gw_to_js</bpmn2:incoming>
      <bpmn2:outgoing>Flow_wyy_to_end</bpmn2:outgoing>
    </bpmn2:userTask>
    <bpmn2:endEvent id="Event_end" name="结束">
      <bpmn2:incoming>Flow_czj_to_end</bpmn2:incoming>
      <bpmn2:incoming>Flow_sz_to_end</bpmn2:incoming>
      <bpmn2:incoming>Flow_wyy_to_end</bpmn2:incoming>
    </bpmn2:endEvent>
    <bpmn2:sequenceFlow id="Flow_start_to_initiator" sourceRef="Event_start" targetRef="Activity_initiator" />
    <bpmn2:sequenceFlow id="Flow_initiator_to_leader" sourceRef="Activity_initiator" targetRef="Activity_leader_approve" />
    <bpmn2:sequenceFlow id="Flow_leader_to_gw" sourceRef="Activity_leader_approve" targetRef="Gateway_region" />
    <bpmn2:sequenceFlow id="Flow_gw_to_dg" name="东莞" sourceRef="Gateway_region" targetRef="Activity_zjb_approve">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${entertainLocation == '东莞'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_gw_to_sz" name="深圳" sourceRef="Gateway_region" targetRef="Activity_sz_confirm">
      <bpmn2:conditionExpression xsi:type="bpmn2:tFormalExpression">${entertainLocation == '深圳'}</bpmn2:conditionExpression>
    </bpmn2:sequenceFlow>
    <bpmn2:sequenceFlow id="Flow_gw_to_js" name="嘉善" sourceRef="Gateway_region" targetRef="Activity_wyy_confirm" />
    <bpmn2:sequenceFlow id="Flow_zjb_to_czj" sourceRef="Activity_zjb_approve" targetRef="Activity_czj_confirm" />
    <bpmn2:sequenceFlow id="Flow_czj_to_end" sourceRef="Activity_czj_confirm" targetRef="Event_end" />
    <bpmn2:sequenceFlow id="Flow_sz_to_end" sourceRef="Activity_sz_confirm" targetRef="Event_end" />
    <bpmn2:sequenceFlow id="Flow_wyy_to_end" sourceRef="Activity_wyy_confirm" targetRef="Event_end" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">

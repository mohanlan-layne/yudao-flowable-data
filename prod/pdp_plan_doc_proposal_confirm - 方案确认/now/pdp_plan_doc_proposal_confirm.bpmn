<?xml version="1.0" encoding="UTF-8"?>
<bpmn2:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:flowable="http://flowable.org/bpmn" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:bpmn2="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsd="http://www.w3.org/2001/XMLSchema" id="diagram_pdp_plan_doc_proposal_confirm" targetNamespace="http://flowable.org/bpmn">
  <bpmn2:process id="pdp_plan_doc_proposal_confirm" name="方案确认" isExecutable="true">
    <bpmn2:startEvent id="Event_start" />
    <bpmn2:userTask id="Activity_execute" name="执行上传">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>60</flowable:candidateStrategy>
        <flowable:candidateParam>${executorUserId}</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId></flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds></flowable:assignEmptyUserIds>
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="false" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="false" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_start_execute" sourceRef="Event_start" targetRef="Activity_execute" />
    <bpmn2:userTask id="Activity_tpm" name="TPM">
      <bpmn2:extensionElements>
        <flowable:candidateStrategy>70</flowable:candidateStrategy>
        <flowable:candidateParam>2</flowable:candidateParam>
        <flowable:assignStartUserHandlerType>1</flowable:assignStartUserHandlerType>
        <flowable:rejectHandlerType>1</flowable:rejectHandlerType>
        <flowable:rejectReturnTaskId></flowable:rejectReturnTaskId>
        <flowable:assignEmptyHandlerType>1</flowable:assignEmptyHandlerType>
        <flowable:assignEmptyUserIds></flowable:assignEmptyUserIds>
        <flowable:approveType>1</flowable:approveType>
        <flowable:buttonsSetting id="1" enable="true" displayName="提交" />
        <flowable:buttonsSetting id="2" enable="false" displayName="拒绝" />
        <flowable:buttonsSetting id="3" enable="true" displayName="转办" />
        <flowable:buttonsSetting id="4" enable="true" displayName="委派" />
        <flowable:buttonsSetting id="5" enable="true" displayName="加签" />
        <flowable:buttonsSetting id="6" enable="true" displayName="退回" />
        <flowable:buttonsSetting id="7" enable="true" displayName="抄送" />
        <flowable:signEnable>false</flowable:signEnable>
        <flowable:reasonRequire>false</flowable:reasonRequire>
      </bpmn2:extensionElements>
    </bpmn2:userTask>
    <bpmn2:sequenceFlow id="Flow_execute_tpm" sourceRef="Activity_execute" targetRef="Activity_tpm" />
    <bpmn2:endEvent id="Event_end" />
    <bpmn2:sequenceFlow id="Flow_tpm_end" sourceRef="Activity_tpm" targetRef="Event_end" />
  </bpmn2:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_pdp_plan_doc_proposal_confirm">
    <bpmndi:BPMNPlane id="pdp_plan_doc_proposal_confirm_di" bpmnElement="pdp_plan_doc_proposal_confirm">
      <bpmndi:BPMNShape id="BPMNShape_Event_start" bpmnElement="Event_start">
        <dc:Bounds x="162" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_execute" bpmnElement="Activity_execute">
        <dc:Bounds x="250" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Activity_tpm" bpmnElement="Activity_tpm">
        <dc:Bounds x="410" y="200" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_Event_end" bpmnElement="Event_end">
        <dc:Bounds x="572" y="222" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_start_execute" bpmnElement="Flow_start_execute">
        <di:waypoint x="198" y="240" />
        <di:waypoint x="250" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_execute_tpm" bpmnElement="Flow_execute_tpm">
        <di:waypoint x="350" y="240" />
        <di:waypoint x="410" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_Flow_tpm_end" bpmnElement="Flow_tpm_end">
        <di:waypoint x="510" y="240" />
        <di:waypoint x="572" y="240" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn2:definitions>
